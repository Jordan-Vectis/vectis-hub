  step            Int     @default(2)
  vendor          String  @default("")
  tote            String  @default("")
  receipt         String  @default("")
  barcode         String  @default("")
  keyPoints       String  @default("") @db.Text
  aiExcluded      Boolean @default(false)
  manualDesc      String  @default("") @db.Text
  category        String  @default("")
  subCategory     String  @default("")
  brand           String  @default("")
  // Estimates stay as TEXT — the draft restores exactly what was typed
  // ("1,200", a half-finished number), not a parsed value.
  estimateLow     String  @default("")
  estimateHigh    String  @default("")
  cond1           String  @default("")
  cond2           String  @default("")
  boxOn           Boolean @default(false)
  boxPrefixMode   String  @default("Box is")
  boxCustomPrefix String  @default("")
  boxCond1        String  @default("")
  boxCond2        String  @default("")
  parcel          String  @default("")
