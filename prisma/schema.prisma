  sizeBytes   Int
  width       Int
  height      Int
  takenBy     String   // email
  takenByName String
  createdAt   DateTime @default(now())
}

// ⚠ The pre-BC lot archive — every lot Vectis sold from 1999 until Business Central
// took over, imported from the old system's spreadsheet export (Databases → Lot
// Archive). Human-written descriptions with the house condition grading, estimates
// and the hammer price. `auctionId` is the OLD system's sale number — and it is
// also the number the website's sale URL STARTS with: /bidding/19-model-train-
// sale-15/4001-10342 is AuctionID 19, site sale id 15, lot 4001, site lot id 10342
// (Jordan, 2026-09-07). So photos are matched by AuctionID then lot number; the
// site's own ids (15, 10342) are read off the sale's pages when needed.
model ArchiveLot {
  id           String    @id @default(cuid())
  auctionId    Int
  auctionDate  DateTime?
  saleTitle    String
  lot          Int
  description  String    @db.Text
  estimateLow  Float?
  estimateHigh Float?
  hammerPrice  Float?
  imageKeys    String[]  @default([]) // (unused — see photoKey)
  // ── Filled by the website pull (lib/archive-site.ts) ──
  // The old system's LotID is what the website calls a lot's unique_id, and its
  // photos are filed under it: lot_images/large/{lotId}/{lotId}.webp. The site's
  // own row id (the number at the end of a lot URL) is siteLotId. Rows the sheet
  // never had are created from the site with source "site".
  lotId           String?
  siteLotId       Int?
  siteLink        String?   // the site's own lot address, e.g. bidding/724-doll-teddy-bear-sale-683/4656-a-boxed-kit-group-751438
  sitePhoto       String?   // the site's main photo path
  photoKey        String?   // our R2 copy for display (the site's "large", ~23 KB: archive-photos/{lotId}.webp)
  photoXlKey      String?   // our R2 backup of the best quality the site holds ("xlarge", ~250 KB: archive-photos/xl/{lotId}.webp)
  siteHammerPrice Float?    // the site's hammer, kept beside the sheet's where they differ
  source          String    @default("sheet")
  importedAt   DateTime  @default(now())

  // ⚠ Identity is the LotID (the old system's key, unique across every sale). Sale +
  // lot number is NOT unique — the report has 1,637 lot numbers repeated within a
  // sale (multi-day sales re-used them) — so it is only an index, and createMany's
  // skipDuplicates dedupes on lotId.
  @@unique([lotId])
  @@index([auctionId, lot])
  @@index([auctionDate])
  @@index([hammerPrice])
}

// Databases → BC Database: what the WEBSITE holds for a Business Central lot that BC's
// own API doesn't — the long description (BC exposes only the 250-char short one),
// the site's link and its photo — keyed on BC's unique ID (site "r008728-194" =
// BC "R008728-194"). Filled by the same website pull as the ABC database; the lot's
// own figures (estimate, hammer, sale) stay on WarehouseItem from the BC sync.
model BcLotWeb {
  uniqueId        String    @id                    // upper-cased, as WarehouseItem.uniqueId
  auctionCode     String?                          // the sale's code from the site URL (D062, F111…)
  lotNumber       Int?
  description     String?   @db.Text               // the site's full description
  siteLotId       Int?
  siteSaleId      Int?                             // the website's own sale number this came from
  siteLink        String?
  sitePhoto       String?
  photoKey        String?                          // bc-photos/{uniqueId}.webp
  photoXlKey      String?                          // bc-photos/xl/{uniqueId}.webp
  siteHammerPrice Float?
  pulledAt        DateTime  @default(now())

  @@index([auctionCode])
  @@index([siteSaleId])
}

// One sale as the website lists it: its own sequential id, the AuctionID it shares
// with the sheet, and whether it has finished (only finished sales are pulled).
model ArchiveSale {
  siteId    Int       @id
  auctionId Int?
  title     String
  saleDate  DateTime?
  lots      Int       @default(0)
  finished  Boolean   @default(false)
  pulledAt  DateTime  @default(now())
  /// The BC sale code (D062) for a Business Central sale — null for the old system's sales.
  code      String?
  /// The sale's cover picture — the "hero" the website's auction calendar shows — as its path
  /// under the site's S3 (auction_images/large/<guid>/<guid>.webp), and our copy in R2 once the
  /// "heroes" job has fetched it (sale-photos/<siteId>.webp). Collected by the office collector
  /// with the lots (2026-09-22); shown on Databases → Sales.
  heroUrl   String?
  heroKey   String?
  heroAt    DateTime?

  @@index([auctionId])
}

// The two long-running archive jobs ("site" = pull lots/LotIDs/photo paths from the
// website; "photos" = copy those photos into R2), resumable from cursor.
model ArchiveJob {
  /// ⚠ "abc" | "bc" | "both" — which database this run is for. The ABC page starts its runs as
  /// "abc" and the BC page as "bc", so BC photos no longer sit behind 948,000 ABC ones.
  scope     String?
  id        String   @id
  cursor    Int      @default(0)
  total     Int      @default(0)
  sales     Int      @default(0)
  matched   Int      @default(0)
  added     Int      @default(0)
  done      Boolean  @default(false)
  error     String?
  note      String?
  startedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One upload of the archive spreadsheet, worked through in chunks so a twenty-year
// file can't time a request out; re-runnable — rows already present are skipped.
model ArchiveImport {
  id        String   @id @default(cuid())
  key       String   // R2 key of the uploaded spreadsheet
  filename  String
  totalRows Int      @default(0)
  offset    Int      @default(0)
  added     Int      @default(0)
  skipped   Int      @default(0)
  bad       Int      @default(0)
  done      Boolean  @default(false)
  error     String?
  startedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pre-typed email reply snippets staff can copy into customer responses.
// Lives behind the IT Tools "Templates" tab.
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("GENERAL")
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// Knowledge base — staff-written solutions and how-tos that the IT Help
// chatbot searches alongside resolved tickets. Plain markdown body keeps
// editing easy; tags + category drive simple keyword matching.
model KnowledgeArticle {
  id            String   @id @default(cuid())
  title         String
  body          String // markdown
  tags          String[] @default([])
  category      String   @default("GENERAL") // GENERAL | HARDWARE | SOFTWARE | NETWORK | APP | HOW_TO
  createdById   String?
  createdByName String
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([updatedAt])
}

// User-editable ticket categories. Pre-seeded with the original hardcoded set
// (HARDWARE, SOFTWARE, NETWORK, APP_BUG, FEATURE_REQUEST, OTHER) but admins
// can add / rename / deactivate via the Manage Categories modal on the
// tickets page. `key` is the stable identifier stored on Ticket.category;
// `label` is what staff see.
model TicketCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// IT ticket system — staff log problems / feature requests, IT works through
// them. Deliberately denormalised (createdByName / assignedToName stored as
// strings) so a deleted user doesn't orphan a ticket's history.
model Ticket {
  id             String          @id @default(cuid())
  title          String
  description    String
  status         String          @default("OPEN") // OPEN | IN_PROGRESS | AWAITING_RESPONSE | RESOLVED | CLOSED
  priority       String          @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  category       String          @default("OTHER") // HARDWARE | SOFTWARE | NETWORK | APP_BUG | FEATURE_REQUEST | OTHER
  createdById    String?
  createdByName  String
  assignedToId   String?
  assignedToName String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  comments       TicketComment[]

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

// ⚠⚠ BC's OWN TRUTH ABOUT WHICH RECEIPT A TOTE IS ON (added 2026-09-08).
//
// In Business Central the receipt-tote table (EVA_TOT_ReceiptTote, Tote Management) is keyed on
// **(Receipt No., Line No.)** — the tote number is only a secondary key. So one tote NUMBER can
// legitimately sit on several receipts: physical totes are re-used over time, and a customer can
// end up with two receipts sharing a tote.
//
// `WarehouseTote` below is UNIQUE on toteNo, so its upsert keeps exactly ONE receipt per tote
// number — whichever the walk wrote last — and every screen reading it gets a single confident
// answer to a question that sometimes has two. That is what put a whole batch under the previous
// customer.
//
// ⚠ This table is DELIBERATELY SEPARATE rather than a change to WarehouseTote. Tote Check,
// Locking Check, End of Day, BC Corrections and Match BC all read WarehouseTote and build a
// tote-keyed map from it; making that table multi-row per tote would silently change what all of
// them report, and the noisy flagging they do now is what Jordan asked to be left alone
// (the 2026-08-20 revert). Nothing in this model is read by any of those. Only the lot wizard's
// lookups use it, so the wizard can say "this tote is on two receipts, pick one" instead of
// guessing — see lib/receipt-totes.ts.
// The tote / vendor / receipt a cataloguer was last working on, PER SALE.
//
// ⚠⚠ These used to be three columns on User — ONE slot per person, shared by every sale, every
// browser tab and every iPad they touch. Whichever tab saved a lot last overwrote it for all the
// others, so coming back to a sale could restore a tote from a different sale entirely, and it
// read as "the numbers reset to an older version". Keyed on the person AND the sale, coming back
// to a sale gives back that sale's batch and nothing else.
//
// ⚠ A sale with no row here starts BLANK on purpose. If they have never catalogued in this sale
// there is nothing to carry over, and carrying another sale's tote in is the bug.
// User.lastTote / lastVendor / lastReceipt are kept as the fallback for the window between this
// code deploying and Run Migrations being clicked — see getLastLotFields.
model CatalogueLastBatch {
  id        String   @id @default(cuid())
  userId    String
  auctionId String
  tote      String?
  vendor    String?
  receipt   String?
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, auctionId])
  @@index([userId])
}

// A vendor (consignor) as Business Central holds them — the C-number customers who send us goods.
//
// Built for BC Reports → Vendor Locations. Nothing else in the Hub had a vendor address: the
// warehouse feeds carry vendorNo and vendorName and nothing more.
//
// ⚠ COUNTRY IS THE AWKWARD FIELD. Evo's own Vendor API (page 75608 EVA_VendorAPI, publisher
// evo/base) is already scoped to auction vendors, which is exactly who we want, but it exposes
// address / city / county / postCode and NO country. Microsoft's standard api/v2.0 vendors entity
// does carry a country letter code but is not auction-scoped. The sync reads the standard one
// first for the country and falls back to Evo's; `source` records which answered, and a blank
// country on a UK-shaped postcode is resolved to GB by the report, never by this table.
model BcVendor {
  id           String    @id @default(cuid())
  /// BC's vendor "No." — the C###### the receipts carry.
  vendorNo     String    @unique
  name         String?
  address      String?
  address2     String?
  city         String?
  county       String?
  postCode     String?
  /// ISO alpha-2 as BC gave it, blank when BC holds none. Never inferred here.
  countryCode  String?
  /// Which endpoint answered: "standard" | "evo". Kept so a wrong-looking report can be traced.
  source       String?
  syncedAt     DateTime  @default(now())

  /// ⚠ A country the HUB worked out, never something Business Central said. Written by the
  /// "work out the missing countries" button (AI) or by hand on the report. It is used only where
  /// BC has no country AND the address rules could not place them, and the report always shows it
  /// as worked out rather than held. Clearing it is one button.
  resolvedCountry String?
  /// "ai" | "manual" — how it was decided, so an odd-looking country can be traced and undone.
  resolvedBy      String?
  /// What the model or the person gave as the reason. Shown on the row.
  resolvedNote    String?
  resolvedAt      DateTime?

  @@index([countryCode])
  @@index([postCode])
}

model WarehouseReceiptTote {
  id          String    @id @default(cuid())
  /// BC's SystemId for the receipt-tote row — the API page's ODataKeyFields, stable across syncs.
  bcSystemId  String    @unique
  receiptNo   String
  toteNo      String
  lineNo      Int?
  vendorNo    String?
  /// The eva/tot API page carries no vendor name; filled from WarehouseItem by vendorNo after a
  /// completed walk. Refreshed when the vendor number changes, unlike WarehouseTote's copy.
  vendorName  String?
  catalogued  Boolean   @default(false)
  bcCreatedAt DateTime?
  syncedAt    DateTime  @default(now())

  @@index([toteNo])
  @@index([receiptNo])
  @@index([toteNo, catalogued])
}

model WarehouseTote {
  id          String    @id @default(cuid())
  toteNo      String    @unique
  location    String?
  receiptNo   String?
  vendorNo    String?
  vendorName  String?
  status      String?
  catalogued  Boolean?
  // What is IN the tote, straight from BC's own tote screen (the eva/tot custom API returns
  // articleCategory / articleSubcategory — confirmed against a live row, not guessed).
  // Shown on the Admin Centre's totes table so an admin can see what a customer sent in.
  category    String?
  subCategory String?
  /// BC's own free-text "Contents Description" off the Receipt Totes screen — what the person
  /// booking the goods in actually wrote ("Tonka 4x Boxes & 1x Tub", "Bears received 02.10.23").
  /// Shown to the cataloguer in the lot wizard so they can tell at a glance they have the right
  /// box. ⚠ Filled by whichever tote feed publishes it — see pickBcContents() in lib/bc.ts.
  contents    String?
  // SystemCreatedAt from Receipt_Totes_Excel — when the tote was created in BC.
  // This is the date the Manager Portal's "Stock from" reads to work out how far
  // behind cataloguing is running. NOT syncedAt, which is just our sync stamp.
  bcCreatedAt DateTime?
  syncedAt    DateTime  @default(now())

  @@index([location])
  @@index([toteNo])
  @@index([catalogued])
}

model WebDescription {
  id          String           @id @default(cuid())
  auctionId   String
  auction     CatalogueAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionCode String
  auctionName String
  description String           @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([auctionId])
}

model SocialPost {
  id             String    @id @default(cuid())
  platform       String    @default("FACEBOOK") // FACEBOOK | INSTAGRAM
  status         String    @default("DRAFT") // DRAFT | SCHEDULED | POSTED | FAILED
  copy           String    @db.Text
  imageUrl       String?
  hashtags       String?
  scheduledAt    DateTime?
  postedAt       DateTime?
  specialDateTag String?
  auctionCode    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

// Models the user has disabled in the Auction AI → Models tab. Presence = disabled.
// Disabled models are hidden from all model selectors/testers.
model DisabledModel {
  modelId   String   @id
  updatedAt DateTime @updatedAt
}

// Per-tool default AI model, set in Admin → AI Models. One row per tool "slot"
// (keys defined in lib/ai-models.ts). Missing row = the tool's built-in default.
model ToolModel {
  slot      String   @id
  modelId   String
  updatedAt DateTime @updatedAt
}

// Admin-editable price per model, USD per 1,000,000 tokens. Only rows an admin
// has actually corrected live here — everything else falls back to the built-in
// table in lib/ai-pricing.ts. Feeds the "what will this run cost" estimate on
// the Auction AI run tabs.
model AiModelRate {
  modelId    String   @id
  inputPerM  Float
  outputPerM Float
  updatedAt  DateTime @updatedAt
}

// Invoice file storage — flat list backed by Cloudflare R2.
// Accessible from /admin/invoices.
model InvoiceFile {
  id         String   @id @default(cuid())
  name       String
  key        String
  size       Int
  mimeType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SocialImage {
  id         String   @id @default(cuid())
  key        String   @unique // R2 object key
  filename   String
  label      String? // user-friendly name/caption
  tags       String? // comma-separated tags
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Lot change log — every field change made via updateLot, with old/new values.
// Used by /admin/lot-log to audit edits and track down data issues.
model CatalogueLotEvent {
  id          String   @id @default(cuid())
  lotId       String
  auctionId   String
  auctionCode String
  lotBarcode  String?
  lotTitle    String?
  action      String   @default("updated") // created | updated | deleted | photo_added | photo_removed | photo_reordered
  source      String? // which tool made the change: lot_wizard, lot_editor, review_tab, photo_tab, ai_pipeline, ai_batch, bulk, import, admin_db, warehouse_fill, restore
  batchId     String? // groups one user action that touched many lots (e.g. a bulk toggle)
  field       String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  changedBy   String
  changedAt   DateTime @default(now())

  @@index([lotId])
  @@index([auctionId])
  @@index([changedAt])
  @@index([batchId])
  @@index([field])
}

// Access Denial Log — records every time an app gate turned a logged-in user
// away, capturing BOTH what the session (JWT) claimed AND what the permission
// read actually returned from the database.
//
// Built 2026-07-16 for an intermittent bug: a cataloguer was sometimes bounced
// to /hub after saving a lot, seeing only the Manager Portal card. Her stored
// permissions were correct and a plain refresh fixed it, so nothing was writing
// her row — which left three possibilities that static code reading could not
// tell apart: the read came back empty, it came back missing an app, or it
// returned a DIFFERENT user's row (idMismatch). This table captures which,
// at the moment it happens.
model AccessDenialLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  appKey    String // which app gate denied — e.g. CATALOGUING
  source    String // which gate ran — e.g. cataloguing_layout
  referer   String? // the page they were on when they got bounced

  // What the session claimed. NOTE: these are the EFFECTIVE user — when an admin
  // is impersonating, getEffectiveSession() returns the TARGET, so sessionUserId
  // is the target's id and idMismatch would read false. isImpersonating/adminId
  // are what reveal that case; without them an impersonation bug would be
  // misfiled as "the row genuinely lacked the app".
  sessionUserId   String
  sessionEmail    String?
  sessionName     String?
  sessionRole     String?
  isImpersonating Boolean @default(false)
  adminId         String? // the real logged-in account when impersonating
  adminName       String?

  // What the permission read actually returned
  dbUserFound   Boolean
  dbUserId      String?
  dbEmail       String?
  dbRole        String?
  dbAllowedApps String[]

  // dbUserId !== sessionUserId — would mean the render read someone else's row
  idMismatch Boolean @default(false)
  note       String?

  @@index([createdAt])
  @@index([sessionUserId])
}

// IT Job Board — jobs auto-created from the IT@vectis.co.uk inbox (or added
// manually). graphMessageId holds the email Message-ID for dedupe/threading;
// threadKey (normalised subject) is the fallback reply-matching key.
model ITJob {
  id             String    @id @default(cuid())
  title          String
  body           String    @default("") @db.Text
  bodyHtml       String?   @db.Text // sanitised HTML of the original email (if sent)
  fromName       String?
  fromEmail      String?
  status         String    @default("NEW") // NEW | IN_PROGRESS | WAITING | DONE
  source         String    @default("EMAIL") // EMAIL | MANUAL
  graphMessageId String?   @unique // email Message-ID
  conversationId String? // Office 365 Conversation Id — precise reply matching
  threadKey      String? // normalised subject — reply matching fallback
  webLink        String? // Outlook deep link to the original email
  assignedToId   String?
  assignedToName String?
  hasNewReply    Boolean   @default(false) // a customer reply arrived that IT hasn't seen
  dueDate        DateTime? // optional target date for the job (date only)
  receivedAt     DateTime?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages    ITJobMessage[]
  attachments ITJobAttachment[]

  @@index([status])
  @@index([receivedAt])
  @@index([threadKey])
  @@index([conversationId])
  @@index([dueDate])
}

// A message on a job — either an internal IT staff note (kind=NOTE) or an
// incoming customer email reply on the same thread (kind=REPLY).
model ITJobMessage {
  id          String   @id @default(cuid())
  jobId       String
  job         ITJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind        String   @default("NOTE") // NOTE | REPLY
  authorName  String?
  authorEmail String?
  body        String   @db.Text
  bodyHtml    String?  @db.Text // sanitised HTML of the reply (if sent)
  createdAt   DateTime @default(now())

  attachments ITJobAttachment[]

  @@index([jobId])
}

// An image attached to a job. messageId is null for the original email's
// images, or set when the image arrived on a reply (ITJobMessage). Stored in R2.
model ITJobAttachment {
  id        String        @id @default(cuid())
  jobId     String
  job       ITJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messageId String?
  message   ITJobMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  r2Key     String
  contentId String? // email Content-ID (set => inline image, e.g. signature; rendered in the HTML, not as a thumbnail)
  createdAt DateTime      @default(now())

  @@index([jobId])
  @@index([messageId])
}

// A saved Marketing Reports layout: an ordered list of report-section ids,
// shared across all users. One can be the default. Managed by admins.
model MarketingLayout {
  id        String   @id @default(cuid())
  name      String
  sections  String[] @default([]) // ordered report-section ids
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shared (not per-user) — a starred report-section is pinned to the top of the
// Marketing Reports page for everyone. One row per favourited section id.
model MarketingFavourite {
  sectionId String   @id
  createdAt DateTime @default(now())
}

// ─── Marketing Business Plan (Marketing Reports → Business Plan tab) ──────────
// A named, saved plan for a period (e.g. "Q4 2026"). The analytics figures it
// was written against are frozen into `snapshot` when the plan is created or
// refreshed, so the PDF always shows the numbers the plan was actually based on
// rather than whatever GA says on the day it is printed.
model MarketingPlan {
  id          String    @id @default(cuid())
  name        String
  periodLabel String? // free text, e.g. "Q4 2026" or "Oct–Dec"
  status      String    @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  rangeKey    String    @default("28d") // GaRange the snapshot was taken over
  ukOnly      Boolean   @default(false)
  excludeBots Boolean   @default(false)
  summary     String? // exec summary / where we are now, in words
  audience    String? // who we're targeting
  competitors String? // competitor notes
  snapshot    Json? // PlanSnapshot — the GA figures frozen at snapshotAt
  snapshotAt  DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  objectives MarketingPlanObjective[]
  actions    MarketingPlanAction[]
}

// One goal for the period, with the analytics figure it is measured on.
model MarketingPlanObjective {
  id        String        @id @default(cuid())
  planId    String
  plan      MarketingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title     String
  metric    String? // label of the figure it's measured on, e.g. "Sessions"
  baseline  String? // where we are now
  target    String? // where we want to be
  dueBy     String?
  notes     String?
  source    String        @default("manual") // manual | ai
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([planId])
}

// One thing we're going to do, filed under a channel.
model MarketingPlanAction {
  id        String        @id @default(cuid())
  planId    String
  plan      MarketingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  channel   String        @default("other") // see PLAN_CHANNELS in lib/marketing-plan.ts
  title     String
  detail    String?
  owner     String?
  dueBy     String?
  effort    String? // Low | Medium | High
  impact    String? // Low | Medium | High
  status    String        @default("TODO") // TODO | DOING | DONE
  source    String        @default("manual") // manual | ai
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([planId])
}

// ─── Accounts (monthly bookkeeping from scanned invoices/receipts) ───────────
// A month is a workspace (e.g. "April 26"); each scanned/manual document becomes
// one categorised line that exports to the April-26-style spreadsheet.
model AccountingMonth {
  id         String               @id @default(cuid())
  label      String               @unique // e.g. "April 26"
  favourite  Boolean              @default(false) // the month currently being worked on (pinned to top)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  documents  AccountingDocument[]
  statements BankStatement[]
}

model AccountingDocument {
  id             String          @id @default(cuid())
  monthId        String
  month          AccountingMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  cardholder     String // "B Goodall" | "J Goodall" | "James" | "Michael" | "Vectis"
  source         String          @default("SCAN") // SCAN | MANUAL
  imageKey       String? // legacy single-image key (superseded by images[])
  images         String[]        @default([]) // R2 keys of every page of this document (multi-page invoices)
  supplier       String          @default("") // description / who it was paid to
  item           String          @default("") // item/service purchased — only if clearly stated on the doc
  website        String          @default("") // supplier website/URL — only if shown on the doc
  docDate        DateTime?
  vatCode        Int             @default(1) // 1 = 20% reclaimable, 2 = none/zero, 7 = personal
  gross          Float           @default(0) // Value (inc VAT)
  vat            Float           @default(0) // VAT amount
  net            Float           @default(0) // gross - vat
  column         String          @default("vectis") // nominal allocation column key (see lib/accounting.ts)
  reviewed       Boolean         @default(false)
  aiRun          Boolean         @default(false) // has AI been run on this scan yet? (blank scans wait for a batch Run AI)
  aiNotes        String? // anything the AI flagged for attention
  splitGroupId   String? // lines split from one invoice share this id (grouped together in the UI)
  currency       String?         @default("GBP") // ISO currency shown on the invoice (GBP unless foreign)
  originalAmount Float? // gross in that foreign currency (e.g. 99 for €99) — stable key for reconciling foreign card charges
  cardLast4      String? // last 4 digits of the PAYING card read off the receipt — drives the Auto match / Unknown card option
  reserved       Boolean         @default(false) // parked in the shared reconcile reserve (belongs to another check) — out of month table/export/matching until pulled in
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([monthId])
}

// Learned categorisation memory — once a supplier is confirmed, reuse it next time.
model AccountingSupplierRule {
  id        String   @id @default(cuid())
  match     String   @unique // normalised supplier text
  vatCode   Int
  column    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The cards / accounts a document can be tagged to (managed by admins).
model AccountingCardholder {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// A bank/card statement uploaded for a month, to reconcile entered lines against.
model BankStatement {
  id           String            @id @default(cuid())
  monthId      String
  month        AccountingMonth   @relation(fields: [monthId], references: [id], onDelete: Cascade)
  label        String            @default("") // e.g. "OneCard May 2026"
  cardholder   String            @default("") // which card/account this statement belongs to — matching is scoped to it
  source       String            @default("SCAN") // SCAN (photo/PDF + AI) | CSV
  images       String[]          @default([]) // R2 keys of the statement pages (photo/PDF)
  createdAt    DateTime          @default(now())
  transactions BankTransaction[]

  @@index([monthId])
}

// One line on a statement. amount = the GBP actually charged (source of truth for cost).
model BankTransaction {
  id             String        @id @default(cuid())
  statementId    String
  statement      BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  monthId        String // denormalised for month-wide queries
  postDate       DateTime?
  tranDate       DateTime?
  description    String        @default("")
  reference      String        @default("") // "Your Ref" / bank reference
  amount         Float         @default(0) // GBP settled amount
  currency       String        @default("GBP") // original currency if a foreign charge
  originalAmount Float? // foreign amount (e.g. 99 for €99)
  feeAmount      Float? // non-sterling transaction fee if shown
  direction      String        @default("DEBIT") // DEBIT | CREDIT (payment/refund)
  matchedDocIds  String[]      @default([]) // entered AccountingDocument id(s) this reconciles to (N = split invoice)
  ignored        Boolean       @default(false) // marked as not needing a match (e.g. a card payment)
  receiptMissing Boolean       @default(false) // real payment but no invoice/receipt exists (chase the paperwork)
  createdAt      DateTime      @default(now())

  @@index([statementId])
  @@index([monthId])
}

// Singleton (id = "global") — stores the delegated OAuth tokens for the shared
// IT mailbox connection. Connected once by an admin via the sign-in flow.
model ITMailboxAuth {
  id           String    @id @default("global")
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  expiresAt    DateTime
  connectedBy  String?
  lastSyncAt   DateTime?
  updatedAt    DateTime  @updatedAt
}

// A customer condition-report request that arrived by email (or was added
// manually). Mirrors the Job Board pattern: emails land here as a list, with
// lot number / auction / date captured (AI-extracted on sync, staff can edit),
// then get assigned to a person and ticked done.
model ConditionReport {
  id             String    @id @default(cuid())
  subject        String // email subject / short title
  body           String    @default("") @db.Text // the customer's actual request text
  fromName       String? // requester (parsed from body, not envelope)
  fromEmail      String?
  fromPhone      String? // requester phone
  navId          String? // NAV / contact id e.g. C125476
  status         String    @default("NEW") // NEW | IN_PROGRESS | DONE
  source         String    @default("EMAIL") // EMAIL | MANUAL
  graphMessageId String?   @unique // Office 365 message id — dedupe key
  webLink        String? // Outlook deep link to the original email
  lotUrl         String? // public "view the lot" link from the email
  receivedAt     DateTime?

  // Captured details
  lotNumber    String? // lot number referenced in the request
  auctionCode  String? // BC auction code e.g. "F093" (from the lot link) — used to find the lot in BC
  auctionId    String? // linked auction (preferred)
  auction      CatalogueAuction? @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  auctionLabel String? // free-text auction name (AI guess / fallback)
  auctionDate  DateTime? // sale date for grouping/sorting

  // Cataloguer (resolved from Business Central by auctionCode + lotNumber)
  cataloguerCode  String? // BC initials e.g. "AR2"
  cataloguerName  String?
  cataloguerEmail String?
  notifiedAt      DateTime? // when the cataloguer was emailed

  // Assignment
  assignedToId   String?
  assignedToName String?

  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([auctionId])
  @@index([receivedAt])
}

// OAuth tokens for the shared mailbox that condition-report emails arrive in.
// Singleton (id = "global"), same delegated-Graph pattern as ITMailboxAuth.
model ConditionMailboxAuth {
  id           String    @id @default("global")
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  expiresAt    DateTime
  connectedBy  String?
  lastSyncAt   DateTime?
  folderId     String? // Graph mail-folder id to read from (null = inbox)
  folderName   String? // display name of that folder, for the UI
  updatedAt    DateTime  @updatedAt
}

// ── MCOC (Jordan's secret-menu Marvel Contest of Champions tools) ────────────
// The player's champion roster. A champ can exist at more than one star level,
// so uniqueness is per (owner, name, stars). `bgsDeck` flags the subset used in
// Battlegrounds. Feeds the counter advisor.
model McocChampion {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  class     String   @default("") // Cosmic | Tech | Mutant | Skill | Science | Mystic
  stars     Int      @default(7) // 6 or 7
  rank      Int      @default(1) // 1–5
  bgsDeck   Boolean  @default(false)
  imageKey  String? // R2 key of the portrait cropped from a roster screenshot
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name, stars])
  @@index([ownerId])
}

// Global (not per-owner) reference DB of every MCOC champion + an AI-computed
// capability profile, cached so the counter engine can match locally/instantly.
// `profileAt` null = catalogued (name/class known) but the full profile hasn't
// been built yet. Rebuilt/refreshed via the Champion DB tab.
model McocChampionProfile {
  id            String    @id @default(cuid())
  name          String // display name
  nameNorm      String    @unique // normalised name (matching + dedupe)
  class         String    @default("") // Cosmic | Tech | Mutant | Skill | Science | Mystic
  immunities    String[]  @default([]) // e.g. Bleed, Poison, Incinerate…
  tags          String[]  @default([]) // counter-relevant capabilities (fixed vocab)
  summary       String    @default("") @db.Text
  abilities     Json? // full kit breakdown: [{ name, details[] }]
  counters      String[]  @default([]) // AI-computed: best attackers INTO this champ as a defender
  myCounters    String[]  @default([]) // Jordan's own counters — NEVER touched by profile rebuilds
  defenderNotes String    @default("") @db.Text // why it's dangerous on defence + what a counter needs
  profileAt     DateTime? // when the full profile was last computed
  updatedAt     DateTime  @updatedAt
}

// Snapshot backing the Manage Lots "Undo" button. One row per bulk action that
// changed lot fields (add/remove conditions, clear descriptions, bulk flags),
// storing each affected lot's before+after values so the action can be reversed.
// Scoped to the actor so a cataloguer only undoes their own mass actions;
// conflict-safe on replay (a lot changed since is skipped). Not FK'd to lots so
// a later lot delete can't cascade it away.
model CatalogueBulkUndo {
  id        String   @id @default(cuid())
  auctionId String
  actorId   String // only this user sees/undoes it
  actorName String   @default("")
  label     String   @default("") // human summary shown on the Undo button
  entries   Json // [{ lotId, fields: { <col>: { before, after } } }]
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([auctionId, actorId, undone, createdAt])
}

// A saved Alliance War attack path (secret /jordan MCOC). One row per fight,
// ordered, per owner. The nodes photo is uploaded once and reused every war
// (the path's nodes don't change); only the defender is overtyped each week.
model McocWarFight {
  id            String   @id @default(cuid())
  ownerId       String
  order         Int      @default(0) // position on the path, 0-based
  defender      String   @default("") // who's on this node this war (overtyped each week)
  nodesImageKey String? // R2 key of the nodes photo for this fight
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
}

// Mini boss node library for the AW planner. The node photos are stable (uploaded
// once per node); each war the player just toggles which nodes they're taking and
// overtypes the defenders — no re-photographing.
model McocMiniNode {
  id            String   @id @default(cuid())
  ownerId       String
  order         Int      @default(0) // legacy list order (map position lives in slot)
  slot          String? // fixed map position key (boss_top, pb_l, pa_c…) — null = unplaced
  label         String   @default("") // e.g. "Node 33"
  defender      String   @default("") // who's on it this war (overtyped each week)
  taking        Boolean  @default(false) // selected for this war
  nodesImageKey String? // R2 key of the node photo (uploaded once)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
}

// A chat explicitly saved from the secret /jordan chat panel (Ask AI or the
// Cooking chef). `mode` keeps the two lists separate. Image data URLs are
// stripped before saving (only a count is kept) so rows stay small.
model JordanSavedChat {
  id        String   @id @default(cuid())
  ownerId   String
  mode      String   @default("chat") // "chat" | "cooking"
  title     String   @default("")
  messages  Json // [{ role, text, queries?, imgs? }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, mode])
}

// Signed acceptance of the iPad Acceptable Use Policy (see lib/terms.ts + components/terms-gate.tsx).
// One row per user per policy version; the drawn signature is stored as a PNG data URL.
// Decoupled from User (plain userId, no FK) so it never affects the login select.
model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  userName   String   @default("")
  userEmail  String   @default("")
  version    String // the TERMS_VERSION accepted
  signature  String   @db.Text // drawn signature, PNG data URL
  acceptedAt DateTime @default(now())

  @@unique([userId, version])
  @@index([userId])
}

// A signed acceptance an admin has withdrawn, so that person has to sign the policy again.
//
// ⚠ WHY THE LIVE ROW IS DELETED AND COPIED HERE, rather than flagged in place. The gate in
// app/(app)/layout.tsx re-prompts on the ABSENCE of a TermsAcceptance row for the current
// version, and TermsAcceptance is unique on (userId, version) — so re-signing overwrites the
// row. Left in place, the old signature would be destroyed by the new one, and a withdrawn
// acceptance would be indistinguishable from never having signed at all.
//
// ⚠ DELIBERATELY NO FOREIGN KEY and every value copied rather than joined. Once the live row is
// gone this is the ONLY evidence that somebody ever signed that version of the policy, which is
// the same reasoning as InductionSignature, TrainingSignature and SavedAiFlag: a record of what
// somebody put their name to must not move or vanish when the thing they signed changes.
model TermsRevocation {
  id         String @id @default(cuid())
  userId     String
  userName   String @default("")
  userEmail  String @default("")

  version    String   // the policy version they had accepted
  signature  String   @db.Text // exactly what they had signed — drawn PNG, or the admin: marker
  acceptedAt DateTime // when they originally signed it

  revokedAt   DateTime @default(now())
  revokedById String
  revokedBy   String   @default("") // name at the time, so a renamed/deleted admin stays readable
  reason      String   @default("") @db.Text

  @@index([userId])
  @@index([revokedAt])
}

// Tracks which version of the MIGRATIONS array was last run, so admins get an
// in-app "migrations pending" banner instead of being told to run them.
// Single row, id = "current". See app/api/admin/run-migrations/route.ts.
model MigrationState {
  id    String   @id // always "current"
  hash  String // sha256 of the MIGRATIONS array when last run clean
  ranBy String?
  ranAt DateTime @updatedAt
}

// End of Day → BC check panels: a flagged warning the team KNOWS is stale
// (e.g. the BC sync hasn't caught up with reality) can be ignored per
// lot + check type. Report-only and reversible — the check still runs; the
// row just files under "ignored" until someone restores it.
model EodCheckDismissal {
  id          String   @id @default(cuid())
  lotId       String
  checkKey    String
  dismissedBy String?
  dismissedAt DateTime @default(now())

  @@unique([lotId, checkKey])
}

// ─── Facilities → First Aid ──────────────────────────────────────────────────
// Everything here is shown on the PUBLIC /first-aid page (no login), so treat every
// field as world-readable. Never add anything confidential to these models.

model FirstAider {
  id        String   @id @default(cuid())
  name      String
  roleTitle String?
  location  String?
  phone     String?
  photoKey  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FirstAidKit {
  id        String   @id @default(cuid())
  kind      String   @default("KIT") // KIT | DEFIB | EYEWASH | OTHER
  label     String
  whereText String?
  photoKey  String?
  // Where this sits on a SitePlan. Held on the kit rather than in a shared pin table so a
  // deleted kit cannot leave an orphan pin behind; a future app (fire, stopcocks) adds the
  // same three fields to its own model and marks up the same plan.
  planId    String?
  pinX      Float? // 0-100, % across the image — a percentage so it survives any screen size
  pinY      Float? // 0-100, % down the image
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FirstAidInfo {
  id             String   @id @default("global")
  emergencySteps String?  @db.Text
  siteAddress    String?  @db.Text
  assemblyPoint  String?
  extraNotes     String?  @db.Text
  updatedAt      DateTime @updatedAt
}

// Submitted from the public page by anyone, so it is an UNAUTHENTICATED write:
// rate limited per ipHash, every field length-capped, and never read back publicly.
// Laid out to follow the UK statutory accident book (BI 510): who was hurt, who is filling it
// in, what happened — then an EMPLOYER-ONLY section only the Hub can reach.
// ⚠ NOT certified as legally compliant — that is for Vectis's H&S people to confirm.
model AccidentReport {
  id            String  @id @default(cuid())
  reporterName  String
  reporterPhone String?
  injuredName   String?
  happenedAt    String?
  location      String?
  description   String  @db.Text

  // Part 1 — about the injured person
  injuredAddress     String?   @db.Text
  injuredOccupation  String?
  // Part 2 — about the person filling this in, when that is someone else
  reporterAddress    String?   @db.Text
  reporterOccupation String?
  // Part 3 — about the accident
  happenedOn         DateTime?
  injuryDetails      String?   @db.Text

  // Part 4 — EMPLOYER ONLY. Never on the public form, only editable in the Hub.
  reportedOn       DateTime?
  recordedBy       String?
  riddorReportable Boolean?
  riddorRef        String?
  employerNotes    String?   @db.Text
  status           String    @default("NEW") // NEW | REVIEWED
  handledBy        String?
  handledAt        DateTime?
  ipHash           String?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

// ─── Facilities → Site Plan ──────────────────────────────────────────────────
// One uploaded drawing of the site that ANY app can mark up. Shown on the PUBLIC first aid
// page, so treat the image and the plan name as world-readable.
model SitePlan {
  id        String   @id @default(cuid())
  name      String
  imageKey  String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Facilities → Induction ──────────────────────────────────────────────────
// Replaces the Induction PowerPoint. The whole point of moving it here is that it stops
// going stale, so the slides live in the DB (admin-editable) and the ones that repeat
// First Aid data render that data LIVE via `liveBlock` instead of retyping it.
model InductionSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  body      String?  @db.Text // blank line = new paragraph, a "- " line = bullet
  imageKey  String? // R2 key, induction/slides/…
  videoUrl  String? // YouTube link, embedded on the slide
  // Pulls live data onto the slide instead of typed text. See LIVE_BLOCKS in lib/induction.ts.
  // NONE | FIRST_AIDERS | KITS | DEFIBS | SITE_PLAN
  liveBlock String   @default("NONE")
  // How it is laid out on the big screen. TITLE | CONTENT | CARDS | STATEMENT — see SLIDE_LAYOUTS.
  // 21 identically-laid-out slides is what made the deck look like a document.
  layout    String   @default("CONTENT")
  // An optional built-in illustration. NULL means "never set" — which is what lets the one-off
  // migration that assigns the standard graphics run exactly once and never clobber a choice.
  graphic   String?
  notes     String?  @db.Text // presenter notes — editor only, never on the big screen
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// A form a new starter reads and signs on the tablet. Admin-editable so more can be added
// without a developer. `key` is stable so the seeded two can be found again.
model InductionForm {
  id           String   @id @default(cuid())
  key          String   @unique
  title        String
  intro        String?  @db.Text // shown above the terms
  body         String?  @db.Text // the terms themselves
  declaration  String?  @db.Text // the sentence directly above the signature
  askCompany   Boolean  @default(true)
  askJobTitle  Boolean  @default(true)
  askStartDate Boolean  @default(false)
  askNotes     Boolean  @default(false) // free-text "anything you want to ask?" box
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items InductionFormItem[]
}

model InductionFormItem {
  id        String  @id @default(cuid())
  formId    String
  label     String  @db.Text
  detail    String? @db.Text
  required  Boolean @default(true)
  sortOrder Int     @default(0)

  form InductionForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

// ⚠ A signed record must OUTLIVE the form it came from — the form is editable and deletable,
// and a signature that changed meaning later (or vanished) is worthless as a record. So there
// is deliberately NO foreign key to InductionForm, and the wording that was on screen is
// snapshotted onto the row. Same reasoning as TermsAcceptance being decoupled from User.
// The signer is NOT a Hub user: the tablet is logged in as an admin and handed over, which is
// why the name/company/job title are typed in and `takenBy*` records who was logged in.
model InductionSignature {
  id                  String   @id @default(cuid())
  formId              String
  formKey             String   @default("")
  formTitle           String
  bodySnapshot        String?  @db.Text
  declarationSnapshot String?  @db.Text
  items               Json? // [{ label, ticked }] — exactly what they confirmed
  personName          String
  company             String?
  jobTitle            String?
  startDate           String?
  notes               String?  @db.Text
  signature           String   @db.Text // drawn signature, PNG data URL
  takenById           String?
  takenByName         String?
  signedAt            DateTime @default(now())

  @@index([formId])
  @@index([personName])
  @@index([signedAt])
}

// ─── IT & Admin → Training ───────────────────────────────────────────────────
// A course per panel of the Hub. Same reasoning as the Induction deck: the content lives
// in the DB and is editable in the app, so a lesson can be corrected the day the panel it
// describes changes. A screenshot-laden document in a shared folder is wrong within a month
// and nobody ever finds out.
model TrainingModule {
  id        String   @id @default(cuid())
  // Matches the Hub card key where there is one (ADMIN_CENTRE, CATALOGUING…), so a module
  // can be found again after a rename and the seed can never duplicate one.
  key       String   @unique
  title     String
  icon      String   @default("📘")
  blurb     String?  @db.Text
  href      String? // the panel this teaches — drives "Open it" and the practice pane
  // The AppKey that gates the panel itself. Training is readable by everyone; this is only
  // used to tell someone they cannot open the tool they are being taught.
  appKey    String?
  accent    String   @default("indigo")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slides    TrainingSlide[]
  exercises TrainingExercise[]

  @@index([sortOrder])
}

// One slide of a module's deck. Same shape as InductionSlide on purpose — the presenter and
// the body parser are shared — plus `tryHref`, which is the thing an induction slide never
// needs: a lesson about a screen should be able to open that screen.
model TrainingSlide {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  subtitle  String?
  body      String?  @db.Text // blank line = new paragraph, a "- " line = bullet
  imageKey  String? // R2 key, training/slides/…
  videoUrl  String?
  layout    String   @default("CONTENT") // TITLE | CONTENT | CARDS | STATEMENT
  graphic   String   @default("NONE")
  tryHref   String?
  tryLabel  String?
  notes     String?  @db.Text // presenter notes — editor only, never on the big screen
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, sortOrder])
}

// A "now you do it" task. ⚠ `params.mode = "PICK"` is the important one: the server chooses a
// real, currently-existing lot/sale when the exercise is served and derives the right answer
// from the live data. An exercise with a barcode typed into it stops working the moment that
// lot is deleted or the sale is archived — which is exactly how training material rots.
model TrainingExercise {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  brief     String   @db.Text // supports {{q}} — replaced with whatever was picked
  panel     String? // which tab to open beside it (Admin Centre: find | who | sale)
  kind      String   @default("FREE_TEXT")
  params    Json?
  expected  String? // FREE_TEXT / CHOICE only — everything else is derived live
  hint      String?  @db.Text
  explain   String?  @db.Text // shown once answered — why the answer is what it is
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, sortOrder])
}

// Who has been through what. No foreign key to TrainingModule's rows being edited matters
// here — the record is "this person passed this module", and passedIds is a plain array so a
// deleted exercise simply stops counting rather than breaking the row.
model TrainingProgress {
  userId      String
  moduleId    String
  userName    String    @default("")
  slidesSeen  Int       @default(0)
  deckDoneAt  DateTime?
  passedIds   String[]  @default([])
  attempts    Int       @default(0)
  lastAt      DateTime  @default(now())
  completedAt DateTime?

  @@id([userId, moduleId])
  @@index([moduleId])
}

// ─── Admin → Saved AI Flags ──────────────────────────────────────────────────
// A frozen copy of the Review tab's flagged lots, taken before an AI run overwrites them.
//
// ⚠ WHY THIS EXISTS. The pipeline writes CatalogueLot.aiFlagNote with a bare update
// (lib/pipeline-runner.ts) rather than through updateLotLogged, so re-running the AI silently
// replaces the previous flag and NOTHING records what it said. Jack, 2026-08-19: "we are about
// to overwrite them but we cant loose the data".
//
// ⚠ DELIBERATELY NO FOREIGN KEY to CatalogueLot or CatalogueAuction, and every displayed value
// is copied onto the row rather than joined. An archive whose contents change when the live lot
// changes is not an archive — same reasoning as InductionSignature and TermsAcceptance.
model SavedAiFlag {
  id      String @id @default(cuid())
  // One save = one batchId, so a snapshot can be listed, opened and deleted as a unit.
  batchId String
  label   String @default("")

  auctionId   String
  auctionCode String @default("")
  auctionName String @default("")

  lotId           String
  barcode         String?
  receiptUniqueId String?
  title           String   @default("")
  keyPoints       String?  @db.Text
  description     String?  @db.Text
  condition       String?
  category        String?
  subCategory     String?
  brand           String?
  estimateLow     Int?
  estimateHigh    Int?
  aiEstimateLow   Int?
  aiEstimateHigh  Int?
  // R2 keys, copied as they were. ⚠ If the photos are later deleted from R2 the archive keeps
  // the keys but the images stop loading — the flag text and everything else still reads.
  imageUrls       String[] @default([])
  cataloguedBy    String?

  aiFlagNote      String?   @db.Text
  reviewFlag      String?   @db.Text
  reviewFlaggedBy String?
  reviewFlaggedAt DateTime?
  kpFixNote       String?   @db.Text
  kpFixedBy       String?
  kpFixedAt       DateTime?
  // ⚠ The auction's key-point matching mode at save time. analyseKeyPoints is pure — given the
  // same description, key points and mode it returns the same verdict — so storing this is what
  // lets the archive redraw the Review tab's ticks and crosses exactly as they were, rather
  // than recomputing them under whatever mode the sale uses today.
  kpMode          String    @default("strict")

  savedAt     DateTime @default(now())
  savedById   String?
  savedByName String   @default("")

  @@index([batchId])
  @@index([auctionId])
  @@index([savedAt])
}

// ─── JORDAN.SYS — CV workshop (personal, /jordan) ────────────────────────────
// Private to the secret menu: every route is behind isJordan(). Several PROFILES
// so more than one person's CV can live here, each with ONE master CV plus the
// applications tailored from it.
//
// ⚠ The CV itself is a JSON blob, not a table per section. This is a personal
// tool and the shape of a CV is genuinely freeform — four more tables and their
// joins would buy nothing, and a JSON column lets the parser add a section type
// nobody thought of without a migration.
model JordanCvProfile {
  id         String   @id @default(cuid())
  name       String // whose CV this is — "Me", "Kate"
  // The structured CV: { name, headline, email, phone, location, links[],
  // summary, experience[], education[], skills[], extras[] }.
  data       Json     @default("{}")
  // What was read out of the uploaded file, kept so a re-parse never needs the
  // original again and so the AI can be shown the wording actually written.
  rawText    String   @default("") @db.Text
  sourceName String   @default("") // the uploaded file's name, for reference
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  applications JordanCvApplication[]
}

model JordanCvApplication {
  id        String          @id @default(cuid())
  profileId String
  profile   JordanCvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobTitle String @default("")
  company  String @default("")
  jobText  String @default("") @db.Text // the advert, as pasted

  coverLetter String @default("") @db.Text
  // The tailored CV, same shape as JordanCvProfile.data.
  tailoredCv  Json   @default("{}")
  // One line on what the AI changed and why, so an old application explains itself.
  notes       String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([createdAt])
}

// ─── JORDAN.SYS — garage (personal, /jordan) ─────────────────────────────────
// A handful of cars, current and past, with what is due when and a history of
// everything done to them. Every route behind isJordan().
model JordanCar {
  id       String @id @default(cuid())
  nickname String @default("") // "the Golf" — what he actually calls it
  reg      String @default("")
  make     String @default("")
  model    String @default("")
  colour   String @default("")
  year     String @default("")
  fuel     String @default("")
  notes    String @default("") @db.Text

  // R2 object key for the main photo. Under the jordan/ prefix, which the
  // gated proxy insists on — see app/api/jordan/cars/photo/route.ts.
  photoKey String @default("")

  mileage Int? // last known, so "due" can be judged

  // ⚠ Dates are nullable on purpose: "no MOT date recorded" and "MOT due today"
  // must never look the same. A 0/epoch default would have made them identical.
  motDue       DateTime?
  taxDue       DateTime?
  serviceDue   DateTime?
  insuranceDue DateTime?

  // Past cars stay in the same table — the history is the point of keeping them,
  // and moving a row between tables when it is sold would orphan its records.
  isPast      Boolean   @default(false)
  boughtOn    DateTime?
  soldOn      DateTime?
  boughtPrice Int? // whole pounds; nobody needs pence here
  soldPrice   Int?

  position  Int      @default(0) // manual order on screen
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records JordanCarRecord[]

  @@index([isPast])
}

model JordanCarRecord {
  id    String    @id @default(cuid())
  carId String
  car   JordanCar @relation(fields: [carId], references: [id], onDelete: Cascade)

  // MOT | SERVICE | REPAIR | TAX | INSURANCE | OTHER
  kind      String   @default("SERVICE")
  date      DateTime
  mileage   Int?
  costPence Int? // pence, so a £123.45 invoice is exact
  garage    String   @default("")
  /**
   * MOT outcome — "PASS" | "FAIL" | "" (not an MOT, or not recorded).
   */
  result    String   @default("")
  notes     String   @default("") @db.Text
  /**
   * R2 keys — the certificate, the invoice, a photo of an advisory.
   */
  fileKeys  String[] @default([])

  createdAt DateTime @default(now())

  @@index([carId])
  @@index([date])
}

// ─── JORDAN.SYS — documents (personal, /jordan) ──────────────────────────────
// ⚠ SEPARATE TABLES from DocumentFolder/DocumentFile on purpose. Adding an
// "owner" flag to the shared ones would put these on the same page every admin
// opens, one forgotten `where` away from being visible. A private store in a
// menu that is meant to be invisible must not share a table with a public one.
model JordanDocFolder {
  id       String            @id @default(cuid())
  name     String
  parentId String?
  parent   JordanDocFolder?  @relation("JordanFolderChildren", fields: [parentId], references: [id])
  children JordanDocFolder[] @relation("JordanFolderChildren")
  files    JordanDocFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model JordanDocFile {
  id       String           @id @default(cuid())
  name     String
  key      String // R2 object key, always under jordan/docs/
  size     Int              @default(0)
  mimeType String           @default("")
  folderId String?
  folder   JordanDocFolder? @relation(fields: [folderId], references: [id])

  createdAt DateTime @default(now())

  @@index([folderId])
}

// ─── JORDAN.SYS — meal planner (personal, /jordan) ───────────────────────────
// One profile per person: their numbers (for the BMR), their targets and what
// they like to eat. Plans hang off the profile. Every route behind isJordan().
model JordanMealProfile {
  id       String @id @default(cuid())
  name     String // whose numbers these are — "Me", "Kate"
  sex      String @default("male") // "male" | "female" — the BMR formula differs
  age      Int?
  // ⚠ Stored METRIC, entered in stone/pounds and feet/inches (Jordan's choice).
  // Nullable: the targets can't be worked out until all four numbers are in,
  // and a 0 must never be mistaken for "not filled in yet".
  heightCm Float?
  weightKg Float?
  activity String @default("light") // sedentary | light | moderate | active | very

  // What they're trying to do: lose | maintain | muscle | gain (GOAL_DEFS in lib/jordan-meals.ts).
  // It decides the calorie gap on offer, the suggested macro split AND what the AI is told to
  // cook — losing and building muscle are different food at the same calories.
  goal         String @default("lose")
  // Calories a day against maintenance: -500 = lose, 0 = maintain, +250 = gain.
  goalDelta    Int  @default(-500)
  // A daily target typed in by hand — wins over the calculation when set.
  kcalOverride Int?
  proteinPct   Int  @default(30)
  carbsPct     Int  @default(40)
  fatPct       Int  @default(30)
  // Which meals he actually eats, in day order — keys from MEAL_SLOT_OPTIONS. ⚠ EMPTY means the
  // profile predates the tickboxes, and `chosenMeals()` falls back to mealsPerDay rather than
  // reading it as "no meals at all". mealsPerDay is kept in step as the count.
  meals        String[] @default([])
  mealsPerDay  Int  @default(3)

  likes    String @default("") @db.Text
  dislikes String @default("") @db.Text // allergies and hates — the planner must never use these
  notes    String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans        JordanMealPlan[] @relation("MealPlanOwner")
  partnerPlans JordanMealPlan[] @relation("MealPlanPartner")
  gym          JordanGymProfile?
}

model JordanMealPlan {
  id        String            @id @default(cuid())
  profileId String
  profile   JordanMealProfile @relation("MealPlanOwner", fields: [profileId], references: [id], onDelete: Cascade)
  // A couple's plan (2026-09-17): one recipe per meal, split into two portions so both hit their
  // own targets. ⚠ SetNull, not Cascade — deleting the partner's profile must not delete a plan
  // that is still perfectly good for the person who owns it.
  partnerId String?
  partner   JordanMealProfile? @relation("MealPlanPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  title String @default("")
  days  Int    @default(1)
  // The targets the plan was written against, FROZEN — the profile can change afterwards
  // and the plan must still explain itself.
  targets  Json    @default("{}")
  // { title, tips, days: [{ day, meals: [{ slot, name, prepMinutes, ingredients, method, kcal, protein, carbs, fat }] }] }
  plan     Json    @default("{}")
  // { groups: [{ name, items: [{ item, qty, done }] }] } — null until it has been made.
  shopping Json?
  brief    String  @default("") @db.Text // what was asked for this week, as typed
  model    String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([createdAt])
}

// ─── JORDAN.SYS gym (personal, /jordan) ──────────────────────────────────────
// A written programme AND the log of what was actually lifted, because one without the other is
// half a tool: a programme nobody logs can't progress, and a log with no programme is a diary.
// ⚠⚠ The AI writes STRUCTURE ONLY — sets, a rep range, reps-in-reserve, rest. It never writes a
// weight; the weight is computed from JordanSet by double progression (lib/jordan-gym.ts).

model JordanGymProfile {
  id String @id @default(cuid())
  // ⚠ LINKS to the meal profile, never copies it: sex, age, weight and the GOAL are read through
  // this relation every time. A copied goal is the drift bug — the meal planner switches to
  // "lose" and the gym tool carries on adding 2.5 kg a week until every session fails.
  mealProfileId String?            @unique
  mealProfile   JordanMealProfile? @relation(fields: [mealProfileId], references: [id], onDelete: SetNull)

  daysPerWeek    Int    @default(4) // decides the split: 2 = full body, 4 = upper/lower, 5+ = push/pull/legs
  sessionMinutes Int    @default(60) // the hard cap on how many exercises fit
  experience     String @default("intermediate") // beginner | novice | intermediate | advanced
  equipment      String @default("") @db.Text // what the gym HAS. The AI may not prescribe outside it
  injuries       String @default("") @db.Text // movements that must never appear, in his words
  preferences    String @default("") @db.Text // likes and hates, like the meal profile's
  // The plate maths is real maths: the smallest jump possible on a bar is TWICE the smallest
  // plate, so "add 2.5 kg" is impossible if the smallest plate is 2.5.
  barKg          Float  @default(20)
  plates         String @default("25,20,15,10,5,2.5,1.25")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programmes JordanProgramme[]
  workouts   JordanWorkout[]
}

/// The exercise catalogue — the continuity key. Every logged set points at a LIFT, so one
/// movement has one history however it gets spelled. Seeded from LIFT_SEED in lib/jordan-gym.ts.
model JordanLift {
  id          String   @id @default(cuid())
  slug        String   @unique // the identity, e.g. "barbell-back-squat"
  name        String
  aliases     String[] @default([]) // every other name he or the AI might use — matched BEFORE creating a twin
  pattern     String   @default("isolation") // squat | hinge | lunge | *-push | *-pull | isolation | carry | core
  muscles     String[] @default([])
  equipment   String   @default("barbell")
  incrementKg Float    @default(2.5) // the smallest jump THIS gym allows on this lift, never a percentage
  perHand     Boolean  @default(false) // dumbbells are logged per hand. 2×30 logged as 60 corrupts the lift forever
  bodyweight  Boolean  @default(false) // pull-ups/dips — bodyweight is added for the e1RM
  restSec     Int      @default(120)
  main        Boolean  @default(false) // only main lifts get an estimated-1RM PB
  createdAt   DateTime @default(now())

  sets JordanSet[]
}

/// A block of training, frozen exactly like JordanMealPlan — the profile can change afterwards
/// and the programme must still explain itself. ⚠ It holds NO weights.
model JordanProgramme {
  id        String           @id @default(cuid())
  profileId String
  profile   JordanGymProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title       String @default("")
  goal        String @default("maintain") // the GoalKey as it was when this was written
  daysPerWeek Int    @default(4)
  weeks       Int    @default(4)
  // { title, notes, weeks, days: [{ day, name, estimatedMinutes, exercises: [...] }] }
  plan        Json   @default("{}")
  // equipment, injuries, session length and experience FROZEN as they were
  inputs      Json   @default("{}")
  // The performance summary the AI was handed, kept beside the plan it produced, so a bad
  // rewrite can be traced to what it was told.
  digest      String @default("") @db.Text
  brief       String @default("") @db.Text
  model       String @default("")

  startedAt DateTime  @default(now())
  endedAt   DateTime? // null = the block that is running now; only ever one
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workouts JordanWorkout[]

  @@index([profileId])
  @@index([createdAt])
}

/// One gym visit. It exists so a session survives the phone locking, so a session that never
/// happened is visible (a missed week is a progression input, not a gap), and so bodyweight is
/// captured for the lifts loaded by it.
model JordanWorkout {
  id        String           @id @default(cuid())
  profileId String
  profile   JordanGymProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // ⚠ SetNull, not Cascade — deleting an old programme must never take the log with it.
  programmeId String?
  programme   JordanProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  dayKey      String    @default("") // which programme day, COPIED not referenced, so it survives a rewrite
  weekNo      Int       @default(1)
  status      String    @default("IN_PROGRESS") // IN_PROGRESS | DONE | ABANDONED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  bodyweightKg Float?   // so pull-up loads stay comparable across months
  feeling     Int? // 1–5, one tap on finish. Two lifts stalling plus a 2 is recovery, not exercises
  enteredLate Boolean   @default(false) // typed up later from memory — its rest times are not trusted
  notes       String    @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sets JordanSet[]

  @@index([profileId, startedAt])
  @@index([programmeId])
}

/// One set, one row — everything else here is derived from this table.
/// ⚠ There is deliberately NO PB table: a cached PB becomes a lie the moment a typo is fixed.
model JordanSet {
  id String @id @default(cuid())
  // Minted on the PHONE the instant the set is tapped; the save is an upsert on it, so a retry
  // over a bad gym signal can never log the same set twice.
  clientId String @unique

  workoutId String
  workout   JordanWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  liftId    String
  lift      JordanLift    @relation(fields: [liftId], references: [id])

  position       Int     @default(0) // order of the exercise within the session
  setNo          Int     @default(1)
  warmup         Boolean @default(false) // excluded from every count, decision and PB
  targetReps     String  @default("") // "6-8", what was asked
  targetWeightKg Float? // what the tool suggested, kept beside what he did so a miss is visible
  weightKg       Float // ⚠ PER HAND on a perHand lift, always
  reps           Int
  rir            Int? // reps in reserve
  est1rm         Float? // Epley, working sets of ≤10 reps only, + bodyweight where it counts
  loggedAt       DateTime @default(now()) // the real clock at the tap — rest taken is the gap between rows
  note           String   @default("")

  @@index([workoutId])
  @@index([liftId, loggedAt])
  @@index([liftId, est1rm])
}

// ─── Training → sign-off ─────────────────────────────────────────────────────
// Signed at the end of a course, once every practice task has been passed.
//
// ⚠ DELIBERATELY NO FOREIGN KEY to TrainingModule, and the course title, the declaration wording
// and the counts are all COPIED onto the row. A signed record must outlive the thing it refers
// to: courses are editable and deletable, and "Jack confirmed he was trained" is worth nothing
// if what he was trained ON can be reworded afterwards. Same reasoning as InductionSignature.
model TrainingSignature {
  id          String  @id @default(cuid())
  userId      String
  userName    String
  userEmail   String?

  moduleId    String
  moduleKey   String
  moduleTitle String

  // What they actually completed, at the moment they signed.
  slidesTotal Int     @default(0)
  tasksTotal  Int     @default(0)
  tasksPassed Int     @default(0)

  declaration String  @db.Text // the exact wording shown above the signature
  signature   String  @db.Text // drawn signature, PNG data URL
  signedAt    DateTime @default(now())

  @@index([moduleKey])
  @@index([userId])
  @@index([signedAt])
}

// 🚦 Status Centre (/admin/status) — the current state of each outside service the Hub relies
// on, one row per check key (lib/status/checks/*). Written only by lib/status/engine.ts.
model StatusService {
  service       String    @id
  state         String    // ok | degraded | down | unknown | off
  summary       String    @db.Text
  detail        Json?     // { facts: [{ label, value, tone? }] } — never secrets
  latencyMs     Int?
  since         DateTime  @default(now()) // when the current state began
  lastCheckedAt DateTime  @default(now())
  lastOkAt      DateTime?
  badSince      DateTime? // when the current bad spell began, for "had problems for 25 min"
  failStreak    Int       @default(0)
  notifiedState String?   // the state the bell last rang for; null once recovered
  // Switched off by an admin on /admin/status (2026-09-22): never checked, never counted, never rings the
  // bell. NULL = on. ⚠ Nullable with NO default on purpose — Prisma writes a literal default into every
  // INSERT, so a `@default(true)` column would have broken every result write between the deploy and
  // Run Migrations; a nullable column is simply left out of writes that don't mention it.
  disabledAt    DateTime?
  disabledBy    String?
}

// Every check result — the uptime history behind the Status Centre's bars. Pruned after 30 days.
model StatusCheck {
  id        String   @id @default(cuid())
  service   String
  state     String
  summary   String   @db.Text
  latencyMs Int?
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
  @@index([checkedAt])
}

// 🔔 The admin bell's notifications (top bar, before the settings cog). kind "status" = raised
// by the Status Centre. Chosen over email alerts by Jordan, 2026-09-10.
model Notification {
  id        String   @id @default(cuid())
  kind      String
  level     String   // info | warning | error | success
  title     String
  body      String?  @db.Text
  href      String?
  audience  String   @default("ADMIN")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// When each person last opened the bell — everything created after it is unread.
model NotificationSeen {
  userId String   @id
  seenAt DateTime
}

// 📝 Feedback surveys (Admin → Feedback, /admin/feedback). Jordan, 2026-09-10: written questions
// about the Hub — feature requests included — sent as a popup to chosen roles and/or people.
model FeedbackSurvey {
  id              String    @id @default(cuid())
  title           String
  intro           String?   @db.Text
  questions       Json      @default("[]") // [{ id, text }] — written answers only
  status          String    @default("DRAFT") // DRAFT | OPEN | CLOSED
  audienceRoles   String[]  @default([])
  audienceUserIds String[]  @default([])
  createdById     String?
  createdByName   String?
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  responses       FeedbackResponse[]

  @@index([status])
}

// One row per person per survey. LATER = they pressed "Fill it out later" (their typed draft is kept
// and a temporary top-bar button appears for them); SUBMITTED = done. Answers are stored WITH the
// question wording they answered, so editing a question afterwards never changes what was asked.
// ⚠ userId is a plain string, not a relation: a relation would add a field to User (RULES.md).
model FeedbackResponse {
  id          String         @id @default(cuid())
  surveyId    String
  survey      FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId      String
  userName    String?
  status      String // LATER | SUBMITTED
  answers     Json           @default("[]") // [{ questionId, question, answer }]
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([surveyId, userId])
  @@index([userId])
}

// 🔎 Website Search's spelling help — every word in our lot descriptions (accents folded, lower case)
// with how often it appears, so a typo can be matched to a real word. Rebuilt by lib/search-words.ts.
// ⚠ Its trigram index (gin_trgm_ops, needs the pg_trgm extension) lives only in lib/migrations.ts.
model SearchWord {
  word  String   @id // accents folded, lower case
  n     Int      @default(0)
  forms String[] // the accented spellings our descriptions use for it (marklin → märklin)
}

model SearchWordState {
  id            String    @id // always "current"
  builtAt       DateTime?
  words         Int       @default(0)
  buildingSince DateTime? // touched after every batch while a build runs
  error         String?   @db.Text
  version       Int       @default(1)
}

// Scratch table the spelling-list build fills in batches; empty between builds. UNLOGGED (lib/migrations.ts).
model SearchWordBuild {
  raw String @id
  n   Int    @default(0)
}
