generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Roles are stored as free-form strings on User.role. "ADMIN" is the only
// hardcoded role — every other role comes from the RoleDefault table.
// Admins manage roles via /admin/role-defaults (add, edit permissions, delete).

enum SubmissionChannel {
  EMAIL
  WEB_FORM
  PHONE
  WALK_IN
}

enum SubmissionStatus {
  PENDING_ASSIGNMENT
  PENDING_VALUATION
  VALUATION_COMPLETE
  PENDING_CUSTOMER_DECISION
  APPROVED
  DECLINED
  FOLLOW_UP
  COLLECTION_PENDING
  ARRIVED
  COMPLETED
}

enum LogisticsType {
  SENT_IN
  COLLECTION
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  username           String?     @unique
  password           String
  role               String      @default("COLLECTIONS") // "ADMIN" or any custom role name from RoleDefault
  allowedApps        String[]    @default([])
  appPermissions     Json?
  showScanTimer      Boolean     @default(true) // the "away / activity" prompt (long-gap check)
  showLotTimer       Boolean     @default(false) // the little blue count-up timer shown while cataloguing a lot
  timerYellowMins    Int         @default(4)
  timerRedMins       Int         @default(30) // "warn after" mins — house default
  isITStaff          Boolean     @default(false) // can be assigned IT Job Board jobs
  // This person writes their descriptions themselves, so EVERY lot they create is marked
  // aiExcluded — enforced server-side in the lot-creation paths, not left to them ticking a
  // box. The wizard also hides Key Points for them and goes straight to the description.
  // ⚠ Added because cataloguers were typing a description and forgetting the tick, leaving
  // hand-written lots open to being overwritten by an AI run.
  manualDescriptions Boolean     @default(false)
  // Lot Wizard "remember last" fields — follow the user across devices (e.g. shared iPads)
  lastTote           String?
  lastVendor         String?
  lastReceipt        String?
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  assignedSubmissions Submission[]                @relation("AssignedCataloguer")
  createdSubmissions  Submission[]                @relation("CreatedBy")
  valuations          Valuation[]
  contactLogs         ContactLog[]
  bcToken             BCToken?
  devices             Device[]
  departmentLinks     UserDepartment[]
  auctionFavourites   CatalogueAuctionFavourite[]
  lotStart            CataloguerLotStart?
  auctionAccess       CatalogueAuctionAccess[]
  lotDrafts           CatalogueLotDraft[]
}

model BCToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  // Which CatalogueAuction.auctionType values this department covers — this is
  // the link between a sale and the people allowed to work on it. A department
  // can cover several types (a Dolls & Bears department holds DOLLS + BEARS);
  // a type should only be claimed by one department.
  auctionTypes String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  submissions Submission[]
  userLinks   UserDepartment[]
}

// Which people belong to which departments. Many-to-many, because a cataloguer
// can cover more than one (holiday cover, or someone who does both Diecast and
// Matchbox). Supersedes the older single User.departmentId, which is kept only
// so the pre-migration data survives — nothing reads it for access decisions.
model UserDepartment {
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, departmentId])
  @@index([departmentId])
}

model Contact {
  id           String   @id
  salutation   String?
  name         String
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  postcode     String?
  notes        String?
  isSeller     Boolean  @default(false)
  isBuyer      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  receipts        WarehouseReceipt[] @relation("ContactReceipts")
  submissions     Submission[]       @relation("ContactSubmissions")
  customerAccount CustomerAccount?
}

model CustomerAccount {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  firstName           String
  lastName            String
  phone               String?
  sessionToken        String?              @unique
  contactId           String?              @unique
  contact             Contact?             @relation(fields: [contactId], references: [id])
  bidderRegistrations BidderRegistration[]
  commissionBids      CommissionBid[]
  parcels             Parcel[]

  // Shipping address
  shippingLine1    String?
  shippingLine2    String?
  shippingCity     String?
  shippingCounty   String?
  shippingPostcode String?

  // Billing address
  billingLine1          String?
  billingLine2          String?
  billingCity           String?
  billingCounty         String?
  billingPostcode       String?
  billingSameAsShipping Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id                   String            @id @default(cuid())
  reference            String            @unique @default(cuid())
  channel              SubmissionChannel
  status               SubmissionStatus  @default(PENDING_ASSIGNMENT)
  notes                String?
  followUpCount        Int               @default(0)
  lastFollowUpAt       DateTime?
  photoUploadToken     String?           @unique
  valuationToken       String?           @unique
  valuationNotes       String?
  valuationSubmittedAt DateTime?
  valuationSentTo      String?
  needsFollowUp        Boolean           @default(false)

  contactId    String
  contact      Contact     @relation("ContactSubmissions", fields: [contactId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  cataloguerId String?
  cataloguer   User?       @relation("AssignedCataloguer", fields: [cataloguerId], references: [id])
  createdById  String
  createdBy    User        @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       Item[]
  contactLogs ContactLog[]
  logistics   Logistics?
  staffNotes  SubmissionNote[]
}

// Internal staff notes on a submission — a running, timestamped log (not the
// customer's submission `notes`, and separate from the customer ContactLog).
model SubmissionNote {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  body         String     @db.Text
  authorId     String?
  authorName   String
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

model Item {
  id               String   @id @default(cuid())
  name             String
  description      String?
  imageUrls        String[]
  externalEstimate Int?
  externalNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  valuation    Valuation?
}

model Valuation {
  id             String   @id @default(cuid())
  estimatedValue Float
  comments       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  itemId       String @unique
  item         Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cataloguerId String
  cataloguer   User   @relation(fields: [cataloguerId], references: [id])
}

model ContactLog {
  id         String   @id @default(cuid())
  method     String
  notes      String?
  outcome    String?
  isFollowUp Boolean  @default(false)
  createdAt  DateTime @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
}

model AuctionRun {
  id        String       @id @default(cuid())
  code      String       @unique
  preset    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lots      AuctionLot[]
}

model AuctionLot {
  id                  String   @id @default(cuid())
  lot                 String
  description         String   @db.Text
  estimate            String
  originalDescription String?  @db.Text
  keyPoints           String?  @db.Text
  missing             String?  @db.Text
  added               String?  @db.Text
  createdAt           DateTime @default(now())

  runId String
  run   AuctionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model AiPreset {
  key         String   @id
  instruction String   @db.Text
  favourite   Boolean  @default(false)
  archived    Boolean  @default(false) // out of the list and the run dropdowns, but still resolvable by key
  category    String? // header the instruction sits under (null = Uncategorised)
  sortOrder   Int      @default(0) // order within its category (drag-to-reorder)
  updatedAt   DateTime @updatedAt
}

// Persisted category headers for the Auction AI instructions list, so an empty
// header survives (you can create one and drag instructions into it) and header
// order is remembered. Linked to AiPreset by name.
model AiPresetCategory {
  name      String @id
  sortOrder Int    @default(0)
}

model PipelineRun {
  id        String        @id @default(cuid())
  code      String        @unique
  preset    String        @default("")
  model     String        @default("")
  stage     String        @default("batch") // "batch" | "doublecheck" | "kpcheck" | "complete"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lots      PipelineLot[]
}

// ─── Auto Pipeline queue (overnight, server-side) ────────────────────────────
// One sale waiting its turn, with its OWN settings — so a Bears sale can run on
// the bears instruction and, when it finishes, a Trains sale starts on a
// different one without anybody being there. Worked through by the background
// loop in server.js → /api/cron/pipeline-queue, NOT by the browser tab, so it
// keeps going after everyone has gone home.
//
// Per-lot progress still lives in PipelineRun / PipelineLot (keyed by auction
// code), which is what makes a slice resumable: a tick processes what it can,
// saves, and the next tick carries on from the same place.
model PipelineQueueItem {
  id        String  @id @default(cuid())
  code      String // auction code, e.g. "BE0126"
  auctionId String?
  position  Int     @default(0)
  status    String  @default("QUEUED") // QUEUED | RUNNING | PAUSED | DONE | CANCELLED

  // What kind of overnight run this is: "pipeline" (Batch → KP → DC) or
  // "upgrade" (AI Upgrade mass rewrite, held for morning review).
  kind         String @default("pipeline")
  upgradeModes String @default("") // comma-separated AI Upgrade mode keys (kind "upgrade" only)

  // Settings, per sale — these mirror the Auto Pipeline tab's own controls.
  preset         String  @default("")
  model          String  @default("")
  fallbackModel  String  @default("")
  grounded       Boolean @default(false)
  autoApply      Boolean @default(true)
  onlyWithPhotos Boolean @default(false)
  skipHasDesc    Boolean @default(false)
  kpRelaxed      Boolean @default(false)
  // Quick mode: instead of a flat 12s between lots, find the pace Gemini will
  // actually take — start short, widen on a refusal, ease back after a clean
  // run. Off by default, so a sale queued without it behaves exactly as before.
  fastMode       Boolean @default(false)

  // Progress + the morning report.
  stage       String    @default("batch") // batch | kpcheck | doublecheck | complete
  done        Int       @default(0)
  total       Int       @default(0)
  skipped     Int       @default(0) // lots the AI refused (content blocks) — never retried
  retryAfter  DateTime? // set when the whole sale is backing off (rate limits)
  lastMessage String?   @db.Text
  logText     String?   @db.Text
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime? // a stale heartbeat is how a restart reclaims a RUNNING item

  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  upgradeLots UpgradeLot[]

  @@index([status, position])
}

// One rewritten description from an overnight AI Upgrade run, held for morning
// review. Nothing reaches the catalogue until a person accepts it — the row
// itself is also the resume record (a lot with a row is not re-run).
model UpgradeLot {
  id       String            @id @default(cuid())
  queueId  String
  queue    PipelineQueueItem @relation(fields: [queueId], references: [id], onDelete: Cascade)
  lotId    String
  label    String            @default("")
  original String            @default("") @db.Text // the description as it was when rewritten
  revised  String            @default("") @db.Text
  status   String            @default("done") // done | blocked | empty
  accepted Boolean           @default(false)

  createdAt DateTime @default(now())

  @@unique([queueId, lotId])
  @@index([queueId])
}

model PipelineLot {
  id    String      @id @default(cuid())
  runId String
  run   PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  lotId String
  label String

  // Stage 1 — Batch Run
  batchStatus String? // "ok" | "failed" | "skipped"
  description String? @db.Text // running latest text (overwritten by DC)
  batchDesc   String? @db.Text // original raw batch text, preserved for DC before/after
  estimate    String?

  // Stage 2 — Double Check
  dcStatus       String? // "ok" | "issues" | "error" | "skipped"
  contradictions String? @db.Text
  unsupported    String? @db.Text

  // Stage 3 — Key Points Check
  kpStatus  String? // "ok" | "fixed" | "error" | "skipped"
  revised   String? @db.Text
  kpMissing String? @db.Text
  kpAdded   String? @db.Text

  // The description actually applied to the catalogue (Review & Apply). Persisted so a
  // reload knows the lot was applied without re-deriving it from the catalogue text.
  appliedDesc String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, lotId])
}

model Logistics {
  id        String        @id @default(cuid())
  type      LogisticsType
  arrived   Boolean       @default(false)
  arrivedAt DateTime?

  collectionAddress String?
  collectionName    String?
  collectionPhone   String?
  collectionEmail   String?
  collectionNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// When this cataloguer last STARTED a lot, stamped by the server.
//
// ⚠ The idle gap must end when a lot was STARTED, not when it was saved (Jordan, 2026-08-17:
// "someone goes for their lunch comes back makes a lot then the idle timer triggers after
// making the first lot even though they might of spent 10 mins doing the lot"). Measuring to
// save time folds the lot's own working minutes into the break.
//
// ⚠⚠ It is written by the SERVER's clock when the wizard reports a lot start, never sent by
// the device. A client-supplied start (or a client-reported duration subtracted from now)
// would let a tampered device claim a huge lot and erase a real gap — the same class of
// bypass the server-authoritative gate was built to close. One row per user, overwritten.
model CataloguerLotStart {
  userId    String   @id
  startedAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A sale someone has starred on Auction Manager, so the ones they are working on sit at the
// top. ⚠ PER USER, deliberately — "the ones I'm currently working on" is personal, and a
// shared list would have every cataloguer's sales fighting for the same pinned section.
model CatalogueAuctionFavourite {
  userId    String
  auctionId String
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction CatalogueAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@index([auctionId])
}

model CatalogueAuction {
  id                  String                      @id @default(cuid())
  code                String                      @unique
  name                String
  auctionDate         DateTime?
  auctionType         String                      @default("GENERAL")
  eventName           String?
  locked              Boolean                     @default(false)
  finished            Boolean                     @default(false)
  complete            Boolean                     @default(false)
  catalogued          Boolean                     @default(false)
  addedToBC           Boolean                     @default(false)
  photography         Boolean                     @default(false)
  aiRan               Boolean                     @default(false)
  published           Boolean                     @default(false)
  // Review tab key point matching: "strict" (exact wording) or "relaxed"
  // (reworded facts allowed — hard tokens still exact). Set in Auction Settings.
  reviewKpMode        String                      @default("strict")
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  lots                CatalogueLot[]
  photoSessions       CataloguePhotoSession[]
  timingLogs          CatalogueTimingLog[]
  idleLogs            IdleLog[]
  liveAuction         LiveAuction?
  bidderRegistrations BidderRegistration[]
  webDescriptions     WebDescription[]
  conditionReports    ConditionReport[]
  extraAccess         CatalogueAuctionAccess[]
  lotDrafts           CatalogueLotDraft[]
  bcCorrections       CatalogueBcCorrection[]
  favouritedBy        CatalogueAuctionFavourite[]
}

// One-off access to a single sale for someone outside its department — the
// "she's covering this one sale" case. Granted by an admin on the auction's
// Auction Settings tab. Checked alongside the department match in
// lib/departments.ts; it never takes access away, only adds it.
model CatalogueAuctionAccess {
  id        String           @id @default(cuid())
  auctionId String
  userId    String
  auction   CatalogueAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy String?
  createdAt DateTime         @default(now())

  @@unique([auctionId, userId])
  @@index([userId])
}

// Managed cataloguing categories (was a hardcoded CATEGORY_MAP) — editable at /admin/categories.
model LotCategory {
  id            String           @id @default(cuid())
  name          String           @unique
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  subcategories LotSubcategory[]
}

model LotSubcategory {
  id         String      @id @default(cuid())
  categoryId String
  category   LotCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int         @default(0)

  @@unique([categoryId, name])
  @@index([categoryId])
}

// Wording presets for the separate box/packaging condition (e.g. "Box is", "Carded Back is").
// Managed at /admin/condition-wording; read by the lot editors.
model ConditionWording {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Single manual app-wide announcement banner (one "current" row). Set at /admin/announcements,
// shown to everyone via the announcement banner in the app layout.
model Announcement {
  id            String   @id // always "current"
  message       String   @default("") @db.Text
  level         String   @default("warning") // info | warning | success
  active        Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

// Force-refresh signal (one "current" row). An admin bumps `token` from
// /admin/refresh and every open tab reloads onto the newly deployed build.
//
// ⚠ It is a stored token rather than a bare Socket.IO broadcast ON PURPOSE.
// globalThis._io is a single in-process instance with no Redis adapter, so an
// emit only reaches tabs connected to THAT replica — at more than one replica a
// broadcast-only design would silently refresh some iPads and not others, which
// is worse than useless for "everyone must be on the new build". Clients poll
// this token and treat the socket as the fast path. Don't "simplify" it to an
// emit-only design.
model AppReload {
  id              String   @id // always "current"
  token           String   @default("") // changes on every forced refresh
  requestedAt     DateTime @updatedAt
  requestedByName String?
}

// Patch notes — a short "what's changed" note per release, written at
// /admin/announcements (Patch Notes tab) and shown once as a popup to each user.
// Separate from the Announcement banner above: that is one live message for
// something happening now; these are a dated history you add to per release.
// Nothing reaches staff until an admin presses Push (published stays false on save).
model PatchNote {
  id            String          @id @default(cuid())
  title         String          @default("")
  body          String          @default("") @db.Text // one change per line
  published     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdByName String?
  seenBy        PatchNoteSeen[]

  @@index([published, createdAt])
}

// One row per user per patch note they've clicked through. Deliberately minimal:
// this is NOT an audit trail (unlike TermsAcceptance) — it exists only so the
// popup knows not to show that note to that person again. It has to be per-user
// rather than localStorage because the cataloguing iPads are shared: the first
// person to dismiss would otherwise hide the note from everyone who logs in after.
model PatchNoteSeen {
  id          String    @id @default(cuid())
  patchNoteId String
  patchNote   PatchNote @relation(fields: [patchNoteId], references: [id], onDelete: Cascade)
  userId      String
  seenAt      DateTime  @default(now())

  @@unique([patchNoteId, userId])
  @@index([userId])
}

// ─── Admin → Patches & Changes ───────────────────────────────────────────────
// The development record: one row per change that has gone out. Filled from the
// commit history captured at BUILD time (scripts/capture-changelog.mjs) — the
// running app has no git and no GitHub token, so a build is the only moment the
// history is available. Keyed by sha, so re-ingesting the same deploy is a
// no-op and nothing is ever duplicated.
//
// ⚠ Distinct from PatchNote, which is the staff-facing popup on
// /admin/announcements. This one is internal and feeds the manager report.
model DeployChange {
  id          String   @id @default(cuid())
  sha         String   @unique
  subject     String   @db.Text
  author      String?
  committedAt DateTime
  source      String   @default("git") // git | git-shallow | deploy-env | seed
  environment String?
  createdAt   DateTime @default(now())

  @@index([committedAt])
}

// A saved summary of a period's changes, written by the AI and edited by hand,
// for handing to a manager. Kept rather than regenerated so the wording someone
// actually sent can be found again.
model ChangeReport {
  id          String   @id @default(cuid())
  title       String
  periodFrom  DateTime
  periodTo    DateTime
  body        String   @db.Text
  changeCount Int      @default(0)
  model       String? // which AI wrote the first draft
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model BidderRegistration {
  id                String           @id @default(cuid())
  auctionId         String
  auction           CatalogueAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  customerAccountId String
  customerAccount   CustomerAccount  @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  contactId         String? // C number e.g. C000001
  acceptedTerms     Boolean          @default(true)
  registeredAt      DateTime         @default(now())

  @@unique([auctionId, customerAccountId])
}

model LiveAuction {
  id              String           @id @default(cuid())
  auctionId       String           @unique
  auction         CatalogueAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  status          String           @default("PENDING") // PENDING | ACTIVE | PAUSED | COMPLETE
  currentLotIndex Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CatalogueLot {
  id              String    @id @default(cuid())
  title           String
  keyPoints       String    @default("") @db.Text
  description     String    @default("") @db.Text
  barcode         String?
  estimateLow     Int?
  estimateHigh    Int?
  aiEstimateLow   Int?
  aiEstimateHigh  Int?
  startingBid     Int?
  reserve         Int?
  currentBid      Int?
  hammerPrice     Int?
  condition       String?
  vendor          String?
  tote            String?
  receipt         String?
  receiptUniqueId String?
  category        String?
  subCategory     String?
  brand           String?
  notes           String?
  extraDetails    String?   @db.Text
  imageUrls       String[]  @default([])
  // R2 key of the barcode label photo that assigned this lot's photos during a
  // smart scan. Deliberately NOT in imageUrls — it is an internal audit aid for
  // the Photography lot viewer and must never reach the website, BC or AI.
  labelPhotoUrl   String?
  status          String    @default("ENTERED")
  aiExcluded      Boolean   @default(false) // Lot description was typed manually — exclude from all AI runs
  aiUpgraded      Boolean   @default(false)
  addedToBC       Boolean   @default(false) // Manually ticked by cataloguers once a lot has been pushed into Business Central
  reviewFlag      String?   @db.Text // set from the Review tab when a checker spots an error — the reason text
  reviewFlaggedBy String?
  reviewFlaggedAt DateTime?
  aiFlagNote      String?   @db.Text // AI-flagged potential cataloguer mistake from the batch pipeline run
  // Review tab — "the KEY POINTS were wrong, not the description". Set when a checker
  // confirms a key-point mismatch is a cataloguer mistake, so the lot stops being counted
  // as needing attention. kpFixNote says which of the two happened (corrected / left as-is).
  kpFixNote       String?   @db.Text
  kpFixedBy       String?
  kpFixedAt       DateTime?
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auctionId      String
  auction        CatalogueAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  commissionBids CommissionBid[]
  parcelLots     ParcelLot[]
}

// ── BC source code browser (IT Tools → BC Source) ───────────────────────────
// The Evo-soft AL source for our Business Central, uploaded as a zip and kept
// in the DB — deliberately NOT in the git repo (it's the vendor's proprietary
// code and must stay out of GitHub). Re-upload replaces everything.
model BcSourceFile {
  id         String   @id @default(cuid())
  extension  String // top-level folder = one BC extension, e.g. "Evo-auction - Base"
  path       String   @unique // path within Source, e.g. "Evo-auction - Base/src/Table/…"
  name       String // file name alone
  kind       String // Table / Page / Codeunit / Report / … (from the AL naming), else the file type
  content    String   @db.Text
  size       Int
  uploadedAt DateTime @default(now())

  @@index([extension])
}

// One plain-English guide per extension, generated by Gemini from the source
// (regenerate any time) and hand-editable afterwards.
model BcSourceGuide {
  extension   String   @id
  content     String   @db.Text
  model       String?
  generatedBy String?
  edited      Boolean  @default(false)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A lot whose Vendor / Receipt was WRONG in the Hub and has been corrected to
// match the BC tote data ("Match BC" on the Tote Check tab). BC is correct, so
// the wrong values were most likely pushed INTO BC when the sale went over —
// this row is the to-do list for putting that right in BC itself, ticked off on
// the BC Corrections tab.
//
// ⚠ Written at the moment of the correction, because afterwards the lot no
// longer carries the wrong values and the discrepancy would be unrecoverable.
model CatalogueBcCorrection {
  id        String           @id @default(cuid())
  auctionId String
  auction   CatalogueAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  // Deliberately NOT a relation: deleting a lot must not delete the reminder
  // that BC still holds its wrong receipt.
  lotId     String

  barcode         String?
  receiptUniqueId String?
  title           String?
  tote            String?

  // What the Hub had — and therefore what BC most likely received
  oldVendor  String?
  oldReceipt String?
  // What the BC tote data says it should be
  newVendor  String?
  newReceipt String?

  done        Boolean   @default(false)
  doneBy      String?
  doneAt      DateTime?
  correctedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([auctionId, lotId])
  @@index([auctionId, done])
}

// The lot someone was part-way through in the Lot Wizard, autosaved as they type
// so a crash / sign-out / closed tab doesn't lose it ("Resume lot" banner).
// ONE row per user per sale — the wizard only ever has one lot on the go.
// Photos are deliberately NOT kept (camera Files); photoCount is only so the
// resume banner can warn that any photos taken need retaking.
model CatalogueLotDraft {
  id        String           @id @default(cuid())
