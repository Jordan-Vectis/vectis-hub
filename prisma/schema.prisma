// Tamper-proof audit of the idle GATE's decision on every meaningful lot save.
// Written server-side in createLot, so it records the SERVER's own view (real
// clock + DB save times) alongside what the DEVICE claimed (clientNow / clientTz)
// — which exposes a phone whose clock/timezone was changed to dodge the 9–5
// working-hours check, even though the server gate itself never trusts the phone.
// `reason` ∈ TIMER_OFF | NO_HISTORY | UNDER_THRESHOLD | NEW_DAY_GRACE | DAY_OFF |
// CLEARED_BY_REASON | BLOCKED. Diagnostic only — safe to prune.
model IdleGateDecision {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) // server time of the save
  userId      String
  userName    String
  auctionId   String?
  reason      String
  blocked     Boolean   @default(false)
  idleMs      Int       @default(0) // server-computed working-hours gap since last save
  since       DateTime? // the last save the gap is measured from
  thresholdMs Int       @default(0)
  clientNow   DateTime? // what the device clock claimed at save
  clientTz    String? // device timezone (e.g. America/New_York)
  userAgent   String?

  @@index([userId, createdAt])
  @@index([createdAt])
}

// A single working day hidden from ONE cataloguer's performance report by an
// admin (e.g. a half-day or odd day that unfairly drags the daily average down).
// This is a REPORT-ONLY exclusion — the underlying CatalogueTimingLog / IdleLog
// rows are never touched, so the day can be restored at any time by deleting the
// row. `day` is the London calendar-day key "YYYY-MM-DD" (matches ukDayKey()).
// A whole cataloguer hidden from the performance reports — for people who
// aren't really cataloguers (a test account, someone who saved one lot once)
// and would otherwise skew the team averages and clutter the league table.
// REPORT-ONLY, exactly like ReportExcludedDay: no log rows are touched, so it
// is restorable at any time.
// A BC article category an admin has hidden from the Manager Portal →
// Departments "Using totes from" table. Display-only and always restorable —
// nothing about the category or its totes is changed.
model ManagerPortalHiddenCategory {
  category     String   @id
  hiddenById   String
  hiddenByName String
  hiddenAt     DateTime @default(now())
}

